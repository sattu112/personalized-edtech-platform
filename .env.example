# ============================================================
# AdaptEd — Groq AI API Configuration
# ============================================================
#
# 1. Get your FREE API key from: https://console.groq.com/keys
# 2. Copy this file to `.env.local` (never commit `.env.local`)
# 3. Paste your key below. Leave EMPTY to run in full Mock/Demo mode.
#
# Supported Groq Models (free-tier compatible):
#   - llama-3.1-70b-versatile  (default, best quality, 8192 ctx)
#   - llama-3.1-8b-instant     (fastest, 8192 ctx)
#   - mixtral-8x7b-32768       (32k long context, good for docs)
#
# Groq Cloud Docs: https://console.groq.com/docs
#
VITE_GROQ_API_KEY=your_groq_api_key_here

# Optional: Override the default model (advanced)
# VITE_GROQ_MODEL=llama-3.1-70b-versatile

# Optional: Encryption secret for local session data (auto-generated if blank)
# VITE_ENCRYPTION_SECRET=

# ============================================================
# Supabase — Cloud Auth + Persistent Storage (optional)
# ============================================================
# If provided, user progress/auth is backed by Supabase.
# Otherwise, the app runs fully client-side with encrypted localStorage.
#
# 1. Create a project at: https://supabase.com/dashboard
# 2. Copy Project URL + anon public key below.
#
VITE_SUPABASE_URL=https://vnvpwbvfyixadmnmizlg.supabase.co
